# Keep the build context small and clean: exclude VCS, build outputs, local caches,
# frontend test node_modules, and secrets. What's left is the Go module the image builds.
.git
.github
build
bin
dist

# Node / e2e (the app image doesn't run the frontend tests)
node_modules
test-results
playwright-report
blob-report
playwright/.cache

# Local tooling / editor state
.idea
.vscode
.entire
.codex
.cursor

# Secrets and local config — never bake these into an image
.env
.env.*
!.env.example

# Docs and images aren't needed to build the Go binaries
*.md
screenshot.png
logo.svg
